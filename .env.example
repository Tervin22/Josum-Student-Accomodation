# Shared
NODE_ENV=development
APP_NAME="Josum Student Accommodation"
BRAND_LOGO_URL=https://josumres.co.za/wp-content/uploads/2025/08/Josum-Company-Logo-Final-Homepage.png
PUBLIC_APP_URL=http://localhost:3000

# Database
POSTGRES_DB=louiseville_accommodation
POSTGRES_USER=louiseville
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://louiseville:change-me@postgres:5432/louiseville_accommodation?schema=public

# API
API_PORT=4000
API_BASE_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://[::1]:3000
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
INSTALLATION_ADMIN_TOKEN=replace-before-first-admin-bootstrap
FACTORY_RESET_RECOVERY_KEY=replace-with-strong-recovery-key
STAFF_MANAGER_REGISTRATION_KEY=replace-with-strong-manager-registration-key
STAFF_SECURITY_REGISTRATION_KEY=replace-with-strong-security-registration-key
STAFF_TECHNICIAN_REGISTRATION_KEY=replace-with-strong-technician-registration-key
BCRYPT_ROUNDS=12
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
APPLICATION_APPROVAL_EXPIRY_HOURS=72
MAINTENANCE_ACK_SLA_HOURS=24
MAINTENANCE_LOW_RESOLUTION_SLA_HOURS=48
MAINTENANCE_HIGH_RESOLUTION_SLA_HOURS=12
MAINTENANCE_SLA_SWEEP_INTERVAL_MS=300000
PAYMENT_REMINDER_SWEEP_INTERVAL_MS=3600000
PAYMENT_REMINDER_BATCH_SIZE=500

# Email
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Josum Student Accommodation <no-reply@josum.example>"

# File storage
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=/app/uploads
MAX_UPLOAD_BYTES=10485760
STORAGE_MAX_ITEM_IMAGES=6
ALLOWED_UPLOAD_MIME_TYPES=application/pdf,image/jpeg,image/png

# S3-compatible production storage
S3_BUCKET=
S3_REGION=af-south-1
S3_ENDPOINT=
S3_USE_IAM_ROLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_BRAND_LOGO_URL=https://josumres.co.za/wp-content/uploads/2025/08/Josum-Company-Logo-Final-Homepage.png
NEXT_PUBLIC_AUTH_HERO_IMAGE_URL=https://josumres.co.za/wp-content/uploads/2025/08/WhatsApp-Image-2025-07-24-at-15.32.24_7cd2a337.jpg
