# Reference only. Replace values before use. Never commit a real .env file.
POSTGRES_DB=student_residences
POSTGRES_USER=residence_app
POSTGRES_PASSWORD=replace-with-a-local-database-password
DATABASE_URL=postgresql://residence_app:replace-with-a-local-database-password@postgres:5432/student_residences?schema=public
NODE_ENV=development
APP_NAME="Student Residence Portal"
BRAND_LOGO_URL=
PUBLIC_APP_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_BRAND_LOGO_URL=/logo.svg
NEXT_PUBLIC_AUTH_HERO_IMAGE_URL=https://romares.co.za/wp-content/uploads/2026/09/exterior-1.jpg
API_PORT=4000
JWT_ACCESS_SECRET=replace-with-a-unique-access-secret-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-refresh-secret-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ENABLE_ADMIN_BOOTSTRAP=true
INSTALLATION_ADMIN_TOKEN=replace-with-a-private-installation-key
FACTORY_RESET_RECOVERY_KEY=replace-with-a-private-recovery-key
STAFF_MANAGER_REGISTRATION_KEY=replace-with-a-private-manager-key
STAFF_SECURITY_REGISTRATION_KEY=replace-with-a-private-security-key
STAFF_TECHNICIAN_REGISTRATION_KEY=replace-with-a-private-technician-key
BCRYPT_ROUNDS=12
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
APPLICATION_APPROVAL_EXPIRY_HOURS=72
MAINTENANCE_ACK_SLA_HOURS=24
MAINTENANCE_LOW_RESOLUTION_SLA_HOURS=48
MAINTENANCE_HIGH_RESOLUTION_SLA_HOURS=12
MAINTENANCE_SLA_SWEEP_INTERVAL_MS=300000
PAYMENT_REMINDER_SWEEP_INTERVAL_MS=3600000
PAYMENT_REMINDER_BATCH_SIZE=500
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Student Residence Portal <no-reply@example.invalid>"
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=/app/uploads
MAX_UPLOAD_BYTES=10485760
STORAGE_MAX_ITEM_IMAGES=6
ALLOWED_UPLOAD_MIME_TYPES=application/pdf,image/jpeg,image/png
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_USE_IAM_ROLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
ENABLE_SWAGGER=false
