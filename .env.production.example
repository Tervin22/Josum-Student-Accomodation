# Reference only. Replace values before use. Never commit a real .env file.
NODE_ENV=production
APP_NAME="Student Residence Portal"
BRAND_LOGO_URL=
PUBLIC_APP_URL=https://portal.client.example
WEB_ORIGIN=https://portal.client.example
NEXT_PUBLIC_API_URL=https://api.client.example
NEXT_PUBLIC_BRAND_LOGO_URL=/logo.svg
NEXT_PUBLIC_AUTH_HERO_IMAGE_URL=https://romares.co.za/wp-content/uploads/2026/09/exterior-1.jpg
API_PORT=4000
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ENABLE_ADMIN_BOOTSTRAP=false
INSTALLATION_ADMIN_TOKEN=
FACTORY_RESET_RECOVERY_KEY=
STAFF_MANAGER_REGISTRATION_KEY=
STAFF_SECURITY_REGISTRATION_KEY=
STAFF_TECHNICIAN_REGISTRATION_KEY=
BCRYPT_ROUNDS=12
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
APPLICATION_APPROVAL_EXPIRY_HOURS=72
MAINTENANCE_ACK_SLA_HOURS=24
MAINTENANCE_LOW_RESOLUTION_SLA_HOURS=48
MAINTENANCE_HIGH_RESOLUTION_SLA_HOURS=12
MAINTENANCE_SLA_SWEEP_INTERVAL_MS=300000
PAYMENT_REMINDER_SWEEP_INTERVAL_MS=3600000
PAYMENT_REMINDER_BATCH_SIZE=500
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
STORAGE_DRIVER=s3
LOCAL_STORAGE_PATH=/app/uploads
MAX_UPLOAD_BYTES=10485760
STORAGE_MAX_ITEM_IMAGES=6
ALLOWED_UPLOAD_MIME_TYPES=application/pdf,image/jpeg,image/png
S3_BUCKET=
S3_REGION=af-south-1
S3_ENDPOINT=
S3_USE_IAM_ROLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
ENABLE_SWAGGER=false
API_BASE_URL=https://api.client.example
DATABASE_URL=
PORTAL_HOST=portal.client.example
API_HOST=api.client.example
API_IMAGE=residence-api:release
WEB_IMAGE=residence-web:release
